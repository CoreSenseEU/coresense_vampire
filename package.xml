<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>coresense_vampire</name>
  <version>0.0.0</version>
  <description>ROS 2 wrapper of the Vampire automated theorem prover: a reasoning node with TPTP knowledge sessions, a cancellable query action, and external predicates answered by ROS 2 services.</description>
  <maintainer email="martin.suda@cvut.cz">Martin Suda</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <depend>rclpy</depend>
  <depend>coresense_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
